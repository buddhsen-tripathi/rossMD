# ── Ross — credentials ──────────────────────────────────────────────
# LLM gateway (OpenAI-compatible). All agent brains route through here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model routing
ROSS_MODEL_STRONG=google/gemini-2.5-pro
ROSS_MODEL_FAST=google/gemini-2.5-flash

# Corpus + runtime store
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=ross
CLICKHOUSE_SECURE=true

# Case-law ingest (free token: courtlistener.com/help/api/rest/ -> sign up -> profile/api-token)
COURTLISTENER_TOKEN=

# Anti-bot scraping fallback for messy gov sites
NIMBLE_API_KEY=

# Tier-2 web fetch — live primary-source lookup, restricted to authoritative domains
EXA_API_KEY=

# Observability
DD_API_KEY=
DD_SITE=datadoghq.com

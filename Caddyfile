# Ross MD reverse proxy.
#
# Local / IP-only: served over http on :80 (the {$SITE_ADDRESS::80} default).
# Production with a domain: set SITE_ADDRESS=ross.example.com in .env and Caddy
# will provision + renew TLS automatically.
{$SITE_ADDRESS::80} {
	# FastAPI owns /api/* — forward with the prefix intact (FastAPI routes are /api/…)
	@api path /api/*
	reverse_proxy @api api:8080

	# everything else is the Next.js frontend
	reverse_proxy web:8080
}
